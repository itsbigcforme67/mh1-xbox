# The user's own game files never go in the repo
disc/
data/
*.iso
*.bin
*.AFS
*.afs
SLPM_*
SLUS_*
SLES_*
SCPS_*
*.elf
*.dol

__pycache__/
*.pyc
build/
CLAUDE.local.md

# Third-party compilers and loaders, downloaded locally
tools/compilers/
.venv/
tools/binutils

# Disassembly and build output contain Capcom code
asm/
build/
assets/
config/*undefined_*_auto.txt
config/mhg/*undefined_*_auto.txt
.splat/
tools/m2c/
tools/permuter/
tools/ps2recomp/

# owner-supplied Xbox files for xemu (BIOS, MCPX ROM, HDD image): never committed
xbox_files*

# translation tables made by tools/text_dump.py (hold the game text)
text/*
!text/mhg_en_own.tsv
# (our own English: ids + crc32 only, no game text; docs/english_g.md "Our own translation")

# output of ./mh1 (holds the player's copy of the game files)
dist/
xemu.lock
